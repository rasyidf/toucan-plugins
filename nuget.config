<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The Toucan SDK packages come from ./feed until they are published (dotnet pack in the Toucan repository writes here). -->
  <packageSources>
    <clear />
    <add key="toucan-local" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
