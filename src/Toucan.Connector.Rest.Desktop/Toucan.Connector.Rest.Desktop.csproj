<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Toucan.Connector.Rest.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia and the contract come from Toucan at run time. -->
    <PackageReference Include="Toucan.Plugins.Avalonia" Version="1.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia" Version="12.0.5" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
